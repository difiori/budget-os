# Supabase — valores públicos usados pelo browser e pelo servidor Next.js
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Somente servidor — necessários para POST /api/lancamentos
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
SHORTCUT_API_SECRET=gere-um-segredo-longo-e-aleatorio

# Somente para scripts/import-notion-2026.ts via .env.import
NOTION_TOKEN=seu-token-do-notion
SUPABASE_URL=https://seu-projeto.supabase.co
# Filtros opcionais para retomar uma importação pontual
# SOMENTE_PESSOA=Diego
# SOMENTE_MES=2026 | Agosto

# IA (opcional) — liga Lançar rápido, Leitura do mês e Conciliação de fatura.
# Só no servidor (Vercel e .env.local); sem ela os recursos ficam ocultos.
ANTHROPIC_API_KEY=sua-chave-da-anthropic
